{
  "name": "aethelgard-living-chronicles",
  "version": "11.0.0",
  "private": true,
  "description": "An offline-capable browser RPG with genuine local model inference and an optional multiplayer realm.",
  "scripts": {
    "build": "npm run css && python src/build_mud_game.py",
    "test": "node --test --experimental-test-isolation=none tests/*.test.mjs",
    "test:model": "node tests/real-model.mjs",
    "test:browser": "node tests/browser.mjs",
    "css": "tailwindcss -i src/styles.css -o assets/game.css --minify",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "verify": "python tests/verify_mud.py"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "playwright": "1.51.1",
    "tailwindcss": "3.4.17"
  },
  "type": "module"
}
